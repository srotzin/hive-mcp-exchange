    "mcp",
    "model-context-protocol",
    "x402",
    "agentic",
    "ai-agent",
    "ai-agents",
    "llm",
    "hive",
    "hive-civilization",
    "prediction-markets",
    "perpetuals",
    "derivatives",
    "defai",
    "autonomous-trading",
    "usdc",
    "base",
    "base-l2",
    "a2a",
    "agent-economy",
    "agent-card",
    "oac",
    "open-agent-card",
    "attribution",
    "earn"
  ],
  "author": "Steve Rotzin <steve@thehiveryiq.com> (https://www.thehiveryiq.com)",
